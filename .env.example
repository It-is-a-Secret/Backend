# -----------------------------------------------
# BlurSome 환경변수 템플릿
# 이 파일을 복사해 .env 를 만들고 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 gitignore 되어 있습니다. 절대 커밋하지 마세요.
# -----------------------------------------------

# --- 활성 프로파일 (local | prod) ---
ACTIVE=local

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/blursome_dev?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# JWT_SECRET 은 최소 32바이트(256bit) 이상의 임의 문자열이어야 합니다.
JWT_SECRET=change-me-to-a-long-random-secret-key-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRES_IN=1800
JWT_REFRESH_TOKEN_EXPIRES_IN=1209600

# --- AWS S3 (피드 이미지 스토리지) ---
# 버킷·키가 없어도 컨텍스트가 뜨도록 더미 값을 채워 둔다(빈은 항상 생성, 실제 호출은 #55에서 검증).
# 실제 운영 시 originals(비공개)/variants(공개) 2버킷과 IAM access/secret key로 교체한다.
S3_ORIGINALS_BUCKET=blursome-originals-dummy
S3_VARIANTS_BUCKET=blursome-variants-dummy
S3_VARIANTS_BASE_URL=https://blursome-variants-dummy.s3.ap-northeast-2.amazonaws.com/
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy

# --- Kakao OAuth ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 허용할 redirect_uri 화이트리스트(콤마 구분). 카카오 콘솔에 등록한 값과 정확히 일치해야 함.
# 첫 번째 값이 redirect_uri 파라미터 생략 시 사용되는 기본값.
# 예) 로컬·배포 프론트를 모두 받으려면:
#   KAKAO_REDIRECT_URIS=http://localhost:5173/auth,https://front-theta-three-32.vercel.app/auth
KAKAO_REDIRECT_URIS=http://localhost:5173/auth
